rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reactions live under the owning user's document path
    // (`users/{uid}/reactions/{id}`). A user has full ownership of their own
    // reactions; queries scoped to that path are provably allowed, with no
    // cross-user reads and no collection-group lookups.
    match /users/{userId}/reactions/{reactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy top-level jobs (kept for older clients).
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    // Public reaction-template library: readable by everyone (including signed
    // out guests), writable only by signed-in users (used for seeding).
    match /library/{templateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
